            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Held for a human",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "itops-pg"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "itops-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FILTER (WHERE status IN ('awaiting_approval','escalated')) AS held FROM tickets WHERE $__timeFilter(created_at)"
        }
      ],
      "fieldConfig": {
