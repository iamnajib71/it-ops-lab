      }
    },
    {
      "id": 7,
      "title": "Tickets by outcome",
      "type": "piechart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "itops-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "itops-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT status AS metric, count(*) AS value FROM tickets WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true
        },
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        }
      }
    },
    {
      "id": 8,
      "title": "Tickets by category and priority",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "itops-pg"
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "itops-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(category,'unclassified') AS category, count(*) FILTER (WHERE priority='P1') AS \"P1\", count(*) FILTER (WHERE priority='P2') AS \"P2\", count(*) FILTER (WHERE priority='P3') AS \"P3\", count(*) FILTER (WHERE priority='P4') AS \"P4\" FROM tickets WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "options": {
        "stacking": "normal",
        "xField": "category",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "Model usage by task (successful calls)",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "itops-pg"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "itops-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT task, count(*) FILTER (WHERE model='qwen2.5:3b') AS \"qwen2.5:3b\", count(*) FILTER (WHERE model='llama3.1:8b') AS \"llama3.1:8b\", count(*) FILTER (WHERE model='glm-5.3:cloud') AS \"glm-5.3:cloud\" FROM llm_calls WHERE success AND $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "options": {
        "stacking": "normal",
        "xField": "task",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "Model latency over time",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "itops-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "itops-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1m'), model AS metric, avg(latency_ms) AS latency_ms FROM llm_calls WHERE success AND $__timeFilter(created_at) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "points",
            "pointSize": 6
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Gateway events: retries, fallbacks, guards",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "itops-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "itops-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT created_at AS time, ticket_id, task, model, CASE WHEN attempt = 0 THEN 'skipped' ELSE 'failed' END AS outcome, error FROM llm_calls WHERE NOT success AND $__timeFilter(created_at) ORDER BY created_at DESC LIMIT 50"
        }
      ]
    },
    {
      "id": 12,
      "title": "Approval queue (held by the policy gate)",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "itops-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "itops-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT id, created_at AS opened, priority, category, status, round(confidence,2) AS confidence, sla_due_at, (SELECT string_agg(r, '; ') FROM jsonb_array_elements_text(judge_verdict->'gate_reasons') r) AS held_because, summary FROM tickets WHERE status IN ('awaiting_approval','escalated') ORDER BY CASE priority WHEN 'P1' THEN 1 WHEN 'P2' THEN 2 WHEN 'P3' THEN 3 ELSE 4 END, created_at"
        }
      ]
    }
  ]
}